{
 "source_id": "t3_ait_dnsmasq",
 "ecs_version": "8.11",
 "extraction": {
  "kind": "grok",
  "pattern": "^%{SYSLOGTIMESTAMP:timestamp} %{WORD:program}\\[%{POSINT:pid}\\]: query\\[%{WORD:query_type}\\] %{NOTSPACE:query_name} from %{IP:client_ip}$",
  "alternatives": [
   "^%{SYSLOGTIMESTAMP:timestamp} %{WORD:program}\\[%{POSINT:pid}\\]: forwarded %{NOTSPACE:query_name} to %{IP:upstream_ip}$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{WORD:program}\\[%{POSINT:pid}\\]: reply %{NOTSPACE:query_name} is %{NOTSPACE:answer}$"
  ]
 },
 "fields": [
  {
   "source_key": "query_type",
   "ecs_field": "dns.question.type",
   "confidence": 1.0
  },
  {
   "source_key": "query_name",
   "ecs_field": "dns.question.name",
   "confidence": 1.0
  },
  {
   "source_key": "client_ip",
   "ecs_field": "source.ip",
   "confidence": 1.0,
   "type": "ip"
  },
  {
   "source_key": "upstream_ip",
   "ecs_field": "destination.ip",
   "confidence": 1.0,
   "type": "ip"
  },
  {
   "source_key": "answer",
   "ecs_field": "dns.answers.data",
   "confidence": 1.0
  },
  {
   "source_key": "program",
   "ecs_field": "process.name",
   "confidence": 1.0
  },
  {
   "source_key": "pid",
   "ecs_field": "process.pid",
   "confidence": 1.0,
   "type": "long"
  }
 ],
 "constants": {
  "event.category": [
   "network"
  ],
  "event.kind": "event",
  "event.dataset": "dnsmasq.log"
 },
 "unresolved": [
  {
   "source_key": "timestamp",
   "reason": "@timestamp is set at ingest"
  }
 ]
}
