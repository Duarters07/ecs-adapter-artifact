{
 "source_id": "t3_ait_auth",
 "ecs_version": "8.11",
 "extraction": {
  "kind": "grok",
  "pattern": "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: pam_unix\\(%{DATA:pam_service}:session\\): session %{WORD:action} for user %{USERNAME:user}(?: by \\(uid=%{INT:by_uid}\\))?$",
  "alternatives": [
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: Accepted %{WORD:auth_method} for %{USERNAME:user} from %{IP:src_ip} port %{INT:src_port} ssh2(?:: %{GREEDYDATA:key_info})?$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: Did not receive identification string from %{IP:src_ip} port %{INT:src_port}$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: Successful su for %{USERNAME:target_user} by %{USERNAME:user}$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: \\+ %{NOTSPACE:tty} %{USERNAME:user}:%{USERNAME:target_user}$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: New session %{NOTSPACE:session} of user %{USERNAME:user}\\.$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?: Removed session %{NOTSPACE:session}\\.$",
   "^%{SYSLOGTIMESTAMP:timestamp} %{SYSLOGHOST:host} %{DATA:program}(?:\\[%{POSINT:pid}\\])?:  +%{USERNAME:user} : TTY=%{NOTSPACE:tty} ; PWD=%{DATA:pwd} ; USER=%{USERNAME:target_user} ; COMMAND=%{GREEDYDATA:command}$"
  ]
 },
