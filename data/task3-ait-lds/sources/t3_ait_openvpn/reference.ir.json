   "ecs_field": "source.ip",
   "confidence": 1.0,
   "type": "ip"
  },
  {
   "source_key": "client_port",
   "ecs_field": "source.port",
   "confidence": 1.0,
   "type": "long"
  },
  {
   "source_key": "text",
   "ecs_field": "message",
   "confidence": 1.0
  }
 ],
 "constants": {
  "event.category": [
   "network"
  ],
  "event.kind": "event",
  "event.dataset": "openvpn.log"
 },
