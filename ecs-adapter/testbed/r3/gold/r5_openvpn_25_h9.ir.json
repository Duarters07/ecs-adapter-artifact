    "alternatives": [
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) (?:%{DATA:peer_name}/)?%{IP:client_ip}:%{INT:client_port} VERIFY OK: depth=%{INT:depth}, CN=%{GREEDYDATA:cert_cn}$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) (?:%{DATA:peer_name}/)?%{IP:client_ip}:%{INT:client_port} VERIFY ERROR: depth=%{INT:depth}, error=(?<error>[^:]+): CN=%{GREEDYDATA:cert_cn}$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) (?:%{DATA:peer_name}/)?%{IP:client_ip}:%{INT:client_port} TLS Auth Error: %{GREEDYDATA:error}$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) (?:%{DATA:peer_name}/)?%{IP:client_ip}:%{INT:client_port} \\[%{DATA:common_name}\\] Peer Connection Initiated with \\[AF_INET\\]%{IP}:%{INT}$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) (?:%{DATA:peer_name}/)?%{IP:client_ip}:%{INT:client_port} SENT CONTROL \\[%{DATA:common_name}\\]: '%{DATA:control}' \\(status=%{INT:status}\\)$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) (?:%{DATA:peer_name}/)?%{IP:client_ip}:%{INT:client_port} TLS Error: %{GREEDYDATA:error}$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) %{DATA:common_name}/%{IP:client_ip}:%{INT:client_port} MULTI_sva: pool returned IPv4=%{IP:vpn_ip}, IPv6=%{GREEDYDATA:vpn_ipv6}$",
      "^(?<timestamp>%{DAY} %{MONTH} +%{MONTHDAY} %{TIME} %{YEAR}) MULTI_sva: pool returned IPv4=%{IP:vpn_ip}, IPv6=%{GREEDYDATA:vpn_ipv6}$"
    ]
  },
