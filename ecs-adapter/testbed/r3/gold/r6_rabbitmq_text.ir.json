      "type": "ip",
      "confidence": 1.0
    },
    {
      "source_key": "src_port",
      "ecs_field": "source.port",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "dst_ip",
      "ecs_field": "destination.ip",
      "type": "ip",
      "confidence": 1.0
    },
    {
      "source_key": "dst_port",
      "ecs_field": "destination.port",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "user",
      "ecs_field": "user.name",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "reason",
      "ecs_field": "event.reason",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "level",
      "ecs_field": "log.level",
      "type": "keyword",
      "confidence": 1.0
    }
  ],
  "unresolved": [
    {
      "source_key": "timestamp",
      "reason": "@timestamp is set at ingest"
    },
    {
      "source_key": "pid",
      "reason": "Erlang process id, not an OS pid"
    },
    {
      "source_key": "conn",
      "reason": "same as pid"
    },
    {
      "source_key": "vhost",
      "reason": "no ECS field for an AMQP vhost"
    },
    {
      "source_key": "state",
      "reason": "no ECS field"
    }
  ],
  "value_maps": [],
