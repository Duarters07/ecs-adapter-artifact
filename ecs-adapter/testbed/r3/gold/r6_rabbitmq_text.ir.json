{
  "source_id": "r6_rabbitmq_text",
  "ecs_version": "8.11",
  "extraction": {
    "kind": "grok",
    "pattern": "^(?:.\\[[0-9;]*m)?%{TIMESTAMP_ISO8601:timestamp} \\[%{LOGLEVEL:level}\\] <%{DATA:pid}> accepting AMQP connection <%{DATA:conn}> \\(%{IP:src_ip}:%{INT:src_port} -> %{IP:dst_ip}:%{INT:dst_port}\\)(?:.\\[0m)?$",
    "alternatives": [
      "^(?:.\\[[0-9;]*m)?%{TIMESTAMP_ISO8601:timestamp} \\[%{LOGLEVEL:level}\\] <%{DATA:pid}> connection <%{DATA:conn}> \\(%{IP:src_ip}:%{INT:src_port} -> %{IP:dst_ip}:%{INT:dst_port}\\): user '%{DATA:user}' authenticated and granted access to vhost '%{DATA:vhost}'(?:.\\[0m)?$",
      "^(?:.\\[[0-9;]*m)?%{TIMESTAMP_ISO8601:timestamp} \\[%{LOGLEVEL:level}\\] <%{DATA:pid}> closing AMQP connection <%{DATA:conn}> \\(%{IP:src_ip}:%{INT:src_port} -> %{IP:dst_ip}:%{INT:dst_port}(?:, vhost: '%{DATA:vhost}', user: '%{DATA:user}')?\\)(?:.\\[0m)?$",
      "^(?:.\\[[0-9;]*m)?%{TIMESTAMP_ISO8601:timestamp} \\[%{LOGLEVEL:level}\\] <%{DATA:pid}> Error on AMQP connection <%{DATA:conn}> \\(%{IP:src_ip}:%{INT:src_port} -> %{IP:dst_ip}:%{INT:dst_port}(?:, user: '%{DATA:user}')?, state: %{WORD:state}\\):(?:.\\[0m)?$",
      "^(?:.\\[[0-9;]*m)?%{TIMESTAMP_ISO8601:timestamp} \\[%{LOGLEVEL:level}\\] <%{DATA:pid}> PLAIN login refused: user '%{DATA:user}' - %{DATA:reason}(?:.\\[0m)?$",
      "^(?:.\\[[0-9;]*m)?%{TIMESTAMP_ISO8601:timestamp} \\[%{LOGLEVEL:level}\\] <%{DATA:pid}> access to vhost '%{DATA:vhost}' %{WORD:reason} for user '%{DATA:user}'(?:.\\[0m)?$"
    ]
  },
  "fields": [
    {
