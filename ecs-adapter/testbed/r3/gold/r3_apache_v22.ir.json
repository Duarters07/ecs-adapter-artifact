{
  "source_id": "r3_apache_v22",
  "ecs_version": "8.11",
  "extraction": {
    "kind": "grok",
    "pattern": "^\\[%{DATA:ts}\\]\\s+\\[%{LOGLEVEL:level}\\]\\s+\\[client %{IP:client_ip}\\]\\s+user %{NOTSPACE:user}: authentication failure for \"%{DATA:url_path}\": %{DATA:reason}(?:, referer: %{NOTSPACE:referer})?$",
    "alternatives": [
      "^\\[%{DATA:ts}\\]\\s+\\[%{LOGLEVEL:level}\\]\\s+\\[client %{IP:client_ip}\\]\\s+user %{NOTSPACE:user} (?<reason>not found): %{NOTSPACE:url_path}(?:, referer: %{NOTSPACE:referer})?$",
      "^\\[%{DATA:ts}\\]\\s+\\[%{LOGLEVEL:level}\\]\\s+\\[client %{IP:client_ip}\\]\\s+(?<reason>client denied by server configuration): %{NOTSPACE:file_path}(?:, referer: %{NOTSPACE:referer})?$"
    ]
  },
  "timestamp": {"source_key": "ts", "formats": ["EEE MMM dd HH:mm:ss yyyy", "EEE MMM  d HH:mm:ss yyyy"]},
  "fields": [
    {"source_key": "level", "ecs_field": "log.level", "type": "keyword", "confidence": 1.0},
    {"source_key": "client_ip", "ecs_field": "source.ip", "type": "ip", "confidence": 1.0},
    {"source_key": "user", "ecs_field": "user.name", "type": "keyword", "confidence": 1.0},
    {"source_key": "url_path", "ecs_field": "url.path", "type": "keyword", "confidence": 1.0},
    {"source_key": "reason", "ecs_field": "event.reason", "type": "keyword", "confidence": 1.0},
    {"source_key": "referer", "ecs_field": "http.request.referrer", "type": "keyword", "confidence": 1.0}
  ],
  "unresolved": [
    {"source_key": "file_path", "reason": "file system path; file.* is outside the web fieldset this benchmark offers"}
  ],
  "value_maps": [],
  "constants": {"event.kind": "event", "event.category": ["web"], "event.dataset": "apache.error"}
}
