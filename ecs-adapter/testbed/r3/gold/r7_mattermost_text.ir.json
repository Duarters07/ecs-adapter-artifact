{
  "source_id": "r7_mattermost_text",
  "ecs_version": "8.11",
  "extraction": {
    "kind": "grok",
    "pattern": "^%{LOGLEVEL:level} +\\[(?<timestamp>[^\\]]+)\\] (?<msg>Received HTTP request) +caller=\"%{DATA:caller}\" method=%{WORD:method} url=%{NOTSPACE:url} request_id=%{WORD:request_id} user_id=(?<user_id>\\w*) status_code=%{INT:status_code}$",
    "alternatives": [
      "^%{LOGLEVEL:level} +\\[(?<timestamp>[^\\]]+)\\] (?<msg>A user tried to sign in, which matched a Mattermost account, but the password was incorrect\\.) +caller=\"%{DATA:caller}\" path=%{NOTSPACE:path} request_id=%{WORD:request_id} ip_addr=%{IP:ip_addr} user_id=(?<user_id>\\w*) method=%{WORD:method} username=%{NOTSPACE:username}$",
      "^%{LOGLEVEL:level} +\\[(?<timestamp>[^\\]]+)\\] (?<msg>Enter a valid email or username and/or password\\.) +caller=\"%{DATA:caller}\" path=%{NOTSPACE:path} request_id=%{WORD:request_id} ip_addr=%{IP:ip_addr} user_id=(?<user_id>\\w*) method=%{WORD:method} err_where=%{WORD:err_where} http_code=%{INT:http_code} error=\"%{DATA:error}\"$"
    ]
  },
  "fields": [
    {
      "source_key": "ip_addr",
      "ecs_field": "source.ip",
      "type": "ip",
      "confidence": 1.0
    },
    {
      "source_key": "username",
      "ecs_field": "user.name",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "user_id",
      "ecs_field": "user.id",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "status_code",
      "ecs_field": "http.response.status_code",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "method",
      "ecs_field": "http.request.method",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "url",
      "ecs_field": "url.original",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "path",
      "ecs_field": "url.path",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "request_id",
      "ecs_field": "http.request.id",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "error",
      "ecs_field": "error.message",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "msg",
      "ecs_field": "event.action",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "caller",
      "ecs_field": "log.origin.file.name",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "level",
      "ecs_field": "log.level",
      "type": "keyword",
      "confidence": 1.0
    }
  ],
  "unresolved": [
    {
      "source_key": "timestamp",
      "reason": "@timestamp is set at ingest"
    },
    {
      "source_key": "http_code",
      "reason": "repeats the request line's status"
    },
    {
      "source_key": "err_where",
      "reason": "no ECS field"
    }
  ],
  "value_maps": [],
  "constants": {
    "event.kind": "event",
    "event.category": [
      "authentication"
    ],
    "event.dataset": "mattermost.server"
  }
}
