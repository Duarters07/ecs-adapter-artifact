{
  "source_id": "r7_synapse_json",
  "ecs_version": "8.11",
  "extraction": {
    "kind": "grok",
    "pattern": "^\\{\"log\":\"(?<action>Got login request) with identifier: \\{\\x27type\\x27: \\x27m\\.id\\.user\\x27, \\x27user\\x27: \\x27%{DATA:login_user}\\x27\\}, medium: None, address: None, user: None\",\"namespace\":\"%{DATA:logger}\",\"level\":\"%{LOGLEVEL:level}\",\"time\":%{NUMBER:timestamp},\"request\":\"%{DATA:request}\",\"ip_address\":\"%{DATA:client_ip}\",\"site_tag\":\"%{DATA:site}\",\"requester\":(?:null|\"[^\"]*\"),\"authenticated_entity\":(?:null|\"[^\"]*\"),\"method\":\"%{WORD:method}\",\"url\":\"%{DATA:url}\",\"protocol\":\"HTTP/%{DATA:http_version}\",\"user_agent\":\"%{DATA:user_agent}\",\"server_name\":\"%{DATA:server_name}\"\\}$",
    "alternatives": [
      "^\\{\"log\":\"(?<action>Logging in user) (?<user_id>@\\S+) on device %{NOTSPACE:device}\",\"namespace\":\"%{DATA:logger}\",\"level\":\"%{LOGLEVEL:level}\",\"time\":%{NUMBER:timestamp},\"request\":\"%{DATA:request}\",\"ip_address\":\"%{DATA:client_ip}\",\"site_tag\":\"%{DATA:site}\",\"requester\":(?:null|\"[^\"]*\"),\"authenticated_entity\":(?:null|\"[^\"]*\"),\"method\":\"%{WORD:method}\",\"url\":\"%{DATA:url}\",\"protocol\":\"HTTP/%{DATA:http_version}\",\"user_agent\":\"%{DATA:user_agent}\",\"server_name\":\"%{DATA:server_name}\"\\}$",
      "^\\{\"log\":\"(?<action>Failed password login) for user (?<user_id>@\\S+)\",\"namespace\":\"%{DATA:logger}\",\"level\":\"%{LOGLEVEL:level}\",\"time\":%{NUMBER:timestamp},\"request\":\"%{DATA:request}\",\"ip_address\":\"%{DATA:client_ip}\",\"site_tag\":\"%{DATA:site}\",\"requester\":(?:null|\"[^\"]*\"),\"authenticated_entity\":(?:null|\"[^\"]*\"),\"method\":\"%{WORD:method}\",\"url\":\"%{DATA:url}\",\"protocol\":\"HTTP/%{DATA:http_version}\",\"user_agent\":\"%{DATA:user_agent}\",\"server_name\":\"%{DATA:server_name}\"\\}$",
      "^\\{\"log\":\"(?<action>Attempted to login) as (?<user_id>@\\S+) but they do not exist\",\"namespace\":\"%{DATA:logger}\",\"level\":\"%{LOGLEVEL:level}\",\"time\":%{NUMBER:timestamp},\"request\":\"%{DATA:request}\",\"ip_address\":\"%{DATA:client_ip}\",\"site_tag\":\"%{DATA:site}\",\"requester\":(?:null|\"[^\"]*\"),\"authenticated_entity\":(?:null|\"[^\"]*\"),\"method\":\"%{WORD:method}\",\"url\":\"%{DATA:url}\",\"protocol\":\"HTTP/%{DATA:http_version}\",\"user_agent\":\"%{DATA:user_agent}\",\"server_name\":\"%{DATA:server_name}\"\\}$",
      "^\\{\"log\":\"\\S+ - \\d+ - \\{%{DATA:requester}\\} (?<action>Processed request): %{DATA:timing} %{INT:bytes}B %{INT:status} \\\\\"[A-Z]+ \\S+ HTTP/[\\d.]+\\\\\" \\\\\".*?\\\\\" \\[%{INT:dbevts} dbevts\\]\",\"namespace\":\"%{DATA:logger}\",\"level\":\"%{LOGLEVEL:level}\",\"time\":%{NUMBER:timestamp},\"request\":\"%{DATA:request}\",\"ip_address\":\"%{DATA:client_ip}\",\"site_tag\":\"%{DATA:site}\",\"requester\":(?:null|\"[^\"]*\"),\"authenticated_entity\":(?:null|\"[^\"]*\"),\"method\":\"%{WORD:method}\",\"url\":\"%{DATA:url}\",\"protocol\":\"HTTP/%{DATA:http_version}\",\"user_agent\":\"%{DATA:user_agent}\",\"server_name\":\"%{DATA:server_name}\"\\}$"
    ]
  },
