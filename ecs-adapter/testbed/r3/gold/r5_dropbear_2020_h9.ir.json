{
  "source_id": "r5_dropbear_2020_h9",
  "ecs_version": "8.11",
  "extraction": {
    "kind": "grok",
    "pattern": "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) Child connection from %{IP:client_ip}:%{INT:client_port}$",
    "alternatives": [
      "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) (?<result>Password auth succeeded) for '%{DATA:user}' from %{IP:client_ip}:%{INT:client_port}$",
      "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) (?<result>Bad password attempt) for '%{DATA:user}' from %{IP:client_ip}:%{INT:client_port}$",
      "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) (?<result>Login attempt for nonexistent user) from %{IP:client_ip}:%{INT:client_port}$",
      "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) Exit before auth \\(user '%{DATA:user}', %{INT:fails} fails\\): %{GREEDYDATA:reason}$",
      "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) Exit before auth: %{GREEDYDATA:reason}$",
      "^\\[%{INT:pid}\\] (?<timestamp>%{MONTH} +%{MONTHDAY} %{TIME}) Exit \\(%{DATA:user}\\): %{GREEDYDATA:reason}$"
    ]
  },
  "fields": [
    {
      "source_key": "client_ip",
      "ecs_field": "source.ip",
      "type": "ip",
      "confidence": 1.0
    },
    {
      "source_key": "client_port",
      "ecs_field": "source.port",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "user",
      "ecs_field": "user.name",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "pid",
      "ecs_field": "process.pid",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "result",
      "ecs_field": "event.action",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "reason",
      "ecs_field": "event.reason",
      "type": "keyword",
      "confidence": 1.0
    }
  ],
  "unresolved": [
    {
      "source_key": "timestamp",
      "reason": "@timestamp is set at ingest"
    },
    {
      "source_key": "fails",
      "reason": "failure count"
    }
  ],
  "value_maps": [],
  "constants": {
    "event.kind": "event",
    "event.category": [
      "authentication"
    ],
    "event.dataset": "dropbear.log"
  }
