    "pattern": "^(?<timestamp>%{DAY} %{MONTHDAY} %{MONTH} %{YEAR} %{TIME}) (?<type>CONNECT): (?<action>Client connecting) on port %{INT:port} \\(class (?<conn_class>[^)]+)\\): (?<nick>[^!\\s]+)!(?<ident>[^@\\s]+)@%{IP:client_ip} \\(%{IP}\\) \\[(?<realname>[^\\]\\x0f]*)\\x0f?\\]$",
