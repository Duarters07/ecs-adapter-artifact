      "^(?<timestamp>%{DAY} %{MONTHDAY} %{MONTH} %{YEAR} %{TIME}) (?<type>QUIT): (?<action>Client exiting): (?<nick>[^!\\s]+)!(?<ident>[^@\\s]+)@%{IP:client_ip} \\(%{IP}\\) \\[(?<reason>[^\\]]*)\\]$",
      "^(?<timestamp>%{DAY} %{MONTHDAY} %{MONTH} %{YEAR} %{TIME}) (?<type>OPER): (?<nick>\\S+) \\((?<ident>[^@\\s]+)@%{IP:client_ip}\\) \\[%{IP}\\] (?<action>is now a server operator) of type \\x02?(?<oper_type>[^\\s(\\x02]+)\\x02? \\(using account \\x02?(?<oper_name>[^)\\x02]+)\\x02?\\)\\.$",
