  "extraction": {
    "kind": "grok",
    "pattern": "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] (?<action>Accepted connection) %{INT:conn} from \"%{IP:client_ip}:%{INT:client_port}\" on socket %{INT:socket}\\.$",
    "alternatives": [
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] User \"(?<nick>[^!\"]+)!~?(?<ident>[^@\"]+)@%{IP:client_ip}\" (?<action>registered) \\(connection %{INT:conn}\\)\\.$",
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] User \"(?<nick>[^!\"]+)!~?(?<ident>[^@\"]+)@%{IP:client_ip}\" (?<action>rejected|unregistered) \\(connection %{INT:conn}\\): (?<reason>.+?)[!.]$",
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] Client \"(?<nick>[^\"]+)\" (?<action>unregistered) \\(connection %{INT:conn}\\): (?<reason>.+?)\\.$",
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] (?<action>Shutting down connection) %{INT:conn} \\((?<reason>[^)]+)\\) with \"%{IP:client_ip}:%{INT:client_port}\" \\.\\.\\.$",
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] (?<action>Connection) %{INT:conn} with \"%{IP:client_ip}:%{INT:client_port}\" closed \\(in: (?<bytes_in>[\\d.]+k), out: (?<bytes_out>[\\d.]+k)\\)\\.$",
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] (?<action>Got valid OPER) for \"(?<oper_name>[^\"]+)\" from \"(?<nick>[^!\"]+)!~?(?<ident>[^@\"]+)@%{IP:client_ip}\", user is an IRC operator now\\.$",
      "^\\[%{INT:pid}:%{INT:level} +%{INT:uptime}\\] (?<action>Got invalid OPER) from \"(?<nick>[^!\"]+)!~?(?<ident>[^@\"]+)@%{IP:client_ip}\": \"(?<oper_name>[^\"]+)\" -- (?<reason>[^!]+)!$"
    ]
