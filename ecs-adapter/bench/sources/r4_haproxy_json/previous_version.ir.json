{
  "source_id": "r4_haproxy_httplog",
  "ecs_version": "8.11",
  "extraction": {
    "kind": "grok",
    "pattern": "^%{IP:client_ip}:%{INT:client_port} \\[%{NOTSPACE:accept_date}\\] %{NOTSPACE:frontend} %{NOTSPACE:backend}/%{NOTSPACE:server} %{NOTSPACE:timers} %{INT:status} %{INT:bytes_read} %{NOTSPACE:req_cookie} %{NOTSPACE:res_cookie} %{NOTSPACE:term_state} %{NOTSPACE:conns} %{NOTSPACE:queues} \"%{WORD:method} %{NOTSPACE:path} %{DATA:http_version}\"$"
  },
  "fields": [
    {
      "source_key": "client_ip",
      "ecs_field": "source.ip",
      "type": "ip",
      "confidence": 1.0
    },
    {
      "source_key": "client_port",
      "ecs_field": "source.port",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "status",
      "ecs_field": "http.response.status_code",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "bytes_read",
      "ecs_field": "http.response.bytes",
      "type": "long",
      "confidence": 1.0
    },
    {
      "source_key": "method",
      "ecs_field": "http.request.method",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "path",
      "ecs_field": "url.original",
      "type": "keyword",
      "confidence": 1.0
    },
    {
      "source_key": "http_version",
      "ecs_field": "http.version",
      "type": "keyword",
      "confidence": 1.0
    }
  ],
  "unresolved": [
    {
      "source_key": "frontend",
      "reason": "no ECS field for a proxy listener name"
    },
    {
      "source_key": "backend",
      "reason": "no ECS field for a backend pool"
    },
    {
      "source_key": "server",
      "reason": "upstream server name; declined"
    },
    {
      "source_key": "accept_date",
      "reason": "@timestamp is set at ingest"
    },
    {
      "source_key": "timers",
      "reason": "five timers in one token"
    },
    {
      "source_key": "req_cookie",
      "reason": "not captured"
    },
    {
      "source_key": "res_cookie",
      "reason": "not captured"
    },
    {
      "source_key": "term_state",
      "reason": "termination state; no ECS field"
    },
    {
      "source_key": "conns",
      "reason": "connection counters"
    },
    {
      "source_key": "queues",
      "reason": "queue counters"
    }
  ],
  "value_maps": [],
  "constants": {
    "event.kind": "event",
    "event.category": [
      "web"
    ],
    "event.dataset": "haproxy.log"
  }
}
